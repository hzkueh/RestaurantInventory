# Copy this file to .env and fill in your key. .env is git-ignored (see .gitignore).
# The AI summary page is optional — with no key configured, it degrades gracefully
# to an "unavailable" message and the rest of the app is unaffected (see ADR-0002).
#
# Double underscores map to nested .NET configuration (Gemini:ApiKey, Gemini:ModelId).

# Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
Gemini__ApiKey=

# Model ID. Verified on the free tier, Aug 2026 (ADR-0002).
Gemini__ModelId=gemini-3.1-flash-lite
